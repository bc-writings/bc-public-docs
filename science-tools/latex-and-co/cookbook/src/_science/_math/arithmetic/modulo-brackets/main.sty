%%%
% note::
%     ''\NewDocumentCommand'' fabrique des \cmds robustes, donc
%     nous ne faisons pas appel à ''\DeclareRobustCommand''.
%%%


%%%
% prototype::
%    #1 : un contenu mathématique en ligne.
%
%    :action: le contenu ''#1'' mis entre des crochets précédé
%             d'un espace s'adapatant à l'usage, ou non, du mode
%             ''\displaystyle''.
%
%
% note::
%     Expliquons les \cmds utilisées.
%
%         + ''\allowbreak'' autorise à couper une ligne à cet
%         endroit précis si la formule est dans du texte.
%
%         + ''\if@display ... \else ... \fi'' sert à gérer
%         l'utilisation, ou non, du mode ''\displaystyle''.
%
%         + En mode ''\displaystyle'', un espace insécable plus
%         grand est ajouté qu'en mode \std : voir ''\mkern18mu''
%         et ''\mkern8mu'' (''mu'' est pour "mathematical unit").
%%%
\NewDocumentCommand{ \brod }{ m }{%
  \allowbreak%
  \if@display%
    \mkern18mu%
  \else%
    \mkern8mu%
  \fi%
  [#1]%
}


%%%
% prototype::
%    #1 : un contenu mathématique en ligne.
%
%    :action: le texte "mod", mis en forme comme une \fonc, suivi
%             d'un espace insécable, puis du contenu ''#1'' mis
%             entre des crochets via la \cmd ''\brod''.
%
%    :see: cmd.brod
%
%
% note::
%     ''{\operator@font mod}'' écrit juste le texte "mod" via la
%     \mef \std des opérateurs \maths (par défaut, des lettres
%     droites sont utilisées).
%%%
\NewDocumentCommand{ \brmod }{ m }{%
  \brod{{\operator@font mod}\mkern6mu#1}%
}
