%%%
% Le travail est fait par les fonctions ''Apn'', ''Cpn'' et aussi
% ''writefloat2int'' présentes dans le fichier ''main.lua''.
%
%
% note::
%     Pour imprimer des valeurs flottantes renvoyées par \lua sans
%     partie décimale, les macros ''\Apn'' et ''\Cpn''ont besoin
%     de la fonction ''writefloat2int''.
%%%

%%%
% Importation du fichier ''main.lua'' contenant les deux fonctions
% ''Apn'' et ''Cpn'', ainsi que la fonction ''writefloat2int''.
%%%
\directlua{dofile('main.lua')}

%%%
% prototype::
%     #1 : un naturel `n`.
%     #2 : un naturel `p`.
%
%     :return: le nombre d'arrangements de `p` parmi `n`.
%%%
\NewDocumentCommand{ \Apn }{ m m }{%
  \directlua{writefloat2int(Apn(#1, #2))}%
}

%%%
% prototype::
%     #1 : un naturel `n`.
%     #2 : un naturel `p`.
%
%     :return: le nombre de combinaisons de `p` parmi `n`.
%%%
\NewDocumentCommand{ \Cpn }{ m m }{%
  \directlua{writefloat2int(Cpn(#1, #2))}%
}
