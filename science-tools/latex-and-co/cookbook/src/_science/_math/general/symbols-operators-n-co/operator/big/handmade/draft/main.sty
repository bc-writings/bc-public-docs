%%%
% Le \pack ''relsize'' fournit la macro ''\mathlarger''.
%%%
\usepackage{relsize}

%%%
% La macro ''\mathop'' permet de définir un opérateur de type
% ''\sum''.
%%%
\newcommand{\bigast}{%
  \mathop{\Huge\mathlarger{\mathlarger{*}}}%
}

\newcommand{\bigcompo}{%
  \mathop{\Huge\mathlarger{\mathlarger{\circ}}}%
}
