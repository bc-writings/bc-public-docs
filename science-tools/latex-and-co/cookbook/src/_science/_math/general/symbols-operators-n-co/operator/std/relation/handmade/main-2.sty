%%%
% Nous allons utiliser la macro ''\mspace'' du \pack ''amsmath''
% pour gérer l'espacement en mode \math.
%%%
\usepackage{amsmath}

%%%
% ''\DeclareRobustCommand'' ne vérifiant pas l'existence d'une
% macro à créer, nous ajoutons les lignes suivantes qui, le cas
% échéant, nous indiqueront que la macro ''\apart'' ne peut pas
% être redéfinie.
%%%
\newcommand{\apart}{}

%%%
% prototype::
%     :action: création du nouvea symbole.
%
% note::
%     ''\mathpalette'' impose l'emploi d'une macro mangeant deux
%     arguments, le \2nd \arg étant le matériel \math à imprimer.
%     N'ayant pas besoin de ce \2nd \arg, nous donnons ''\relax''
%     qui sera mangé silencieusement par ''\mathpalette''.
%%%
\DeclareRobustCommand%
  {\apart}%
  {\mathrel{\vphantom{/}\mathpalette\apart@\relax}}

%%%
% prototype::
%     #1 : le style mathématique géré par ''\mathpalette''.
%     #2 : un \2nd argument imposé par ''\mathpalette''.
%
% Pour l'emploi de ''\ooalign'', se reporter à la recette de
% simple superposition. Les nouveautés ici sont les suivantes.
%
%     1) ''\m@th'' est un alias pour ''\mathsurround=0pt'' qui
%        retire tout espacement avant et après un matériel
%        mathématique.
%
%     2) ''\hidewidth'' retire tout espacement avant et après
%        le matériel d'une "ligne" de ''\ooalign''. Ceci permet
%        de bien centrer les éléments superposés.
%
%     3) ''\hphantom'' crée un espace horizontal vide, de même
%        largeur que son argument, mais sans rien afficher.
%%%
\NewDocumentCommand{\apart@}{ m m }{%
  \ooalign{%
    \hidewidth$\m@th#1\mspace{-0.5mu}%
    {\not}\mspace{4mu}{\not}%
    \hphantom{=}$\hidewidth\cr
    $\m@th#1=$\cr
  }%
}
