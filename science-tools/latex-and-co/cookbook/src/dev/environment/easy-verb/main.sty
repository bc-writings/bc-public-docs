%%%
% prototype::
%     #1 : cet \arg permet d'agir sur la \mef du texte final.
%     #2 : ceci n'est pas un \arg "utilisateur", c'est juste
%          le réglage permettant de récupérer le contenu de
%          l'\env en mode verbatim.
%
%     :action: le contenu est affiché de façon verbatim en 
%              appliquant au préalable les réglages définis 
%              dans le \1er \arg.
%
%
% note::
%     ''O{\ttfamily}'' définit un \arg optionnel admettant
%     ''\ttfamily'' pour \val par défaut.
%%%
\NewDocumentEnvironment{homemadeverb}{ O{\ttfamily} c }{
  \begin{flushleft}#1{}#2\end{flushleft}
}{}
