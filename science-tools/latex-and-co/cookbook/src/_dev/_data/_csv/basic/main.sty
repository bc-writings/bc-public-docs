%%%
% L'\env ''tblr'' de ''tabularray'' est employé pour fabriquer
% le \tab attendu. Ceci laissae la possibilité à l'utilisateur
% final de choisir finement la \mef des contenus.
%%%
\usepackage{tabularray}

\ExplSyntaxOn

%%%
% prototype::
%     #1 : un \id pour les données.
%     #2 : le chemin relatif du fichier \csv.
%
%     :action: construction d'\assos de clés ''<#1>.i-j'' pour
%              accéder à la donnée en ligne `i` et colonne `j`,
%              la ligne `0` étant celle des étiquettes, et
%              d'\assos de clés ''#1-nbrows'' et ''#1-nbcols''
%              pour les \dims de la table des données.
%
%
% note::
%     Côté utilisateur, des macros sont proposées pour un usage
%     humainement amical des variables \l3 créés ici. Voir les
%     macros ''\csv>...>'' définies plus bas.
%
%
% note::
%     Nous délèguons tout le travail à '' \cookbook_csv_read:nn''
%     codée en \l3 (voir un peu plus bas).
%%%
\NewDocumentCommand{ \csvread }{ m m } {
%%%
% tip::
%     Nous laissons une trace du fichier analysé dans le fichier
%     \log. Ceci permet, par exemple, à \latexmk de savoir qu'il
%     doit compiler de nouveau un \docu en cas de \chgts dans
%     les fichiers de données utilisés.
%%%
  \typeout{(#1)}

  \cookbook_csv_read:nn { #1 } { #2 }
}


%%%
% prototype::
%     #1 : l'\id des données.
%     #2 : le \num de la ligne de la donnée souhaitée.
%     #3 : le \num de la \col de la donnée souhaitée.
%
%     :return: le contenu de la cellule en ligne \no ''#2'' et
%              \col \no ''#3'' de la table de données d'\id
%              ''#1''.
%%%
\NewDocumentCommand{ \csvdata }{ m m m } {
  \prop_item:Ne \l_cookbook_csv_table_prop { #1-#2.#3 }
}


%%%
% prototype::
%     #1 : l'\id des données.
%     #2 : "nbrows" ou "nbcols" suivant que l'on souhaite avoir
%          le \nbre total de lignes ou de \cols.
%        @ #2 in ["nbrows", "nbcols"]
%
%     :return: pour la table d'\id ''#1'', le \nbre de lignes
%              si ''#2'' est ''nbrows'', ou de \cols si ''#2''
%              est ''nbcols''.
%%%
\NewDocumentCommand{ \csvdim }{ m m } {
  \prop_item:Nn \l_cookbook_csv_table_prop { #1-#2 }
}


%%%
% prototype::
%     #1 : l'\id des données.
%     #2 : un \ens d'options au format ''tabularray'', pour
%          mettre en forme le \tab ''tblr'' contenant les
%          données.
%
%     :action: création du \tab de \ttes les données en
%              appliquant les options ''tabularray'' éventuelles
%              indiquées.
%
%
% note::
%     Nous délèguons tout le travail à '' \cookbook_csv_tblr:nn''
%     codée en \l3 (voir un peu plus bas).
%%%
\NewDocumentCommand{ \csvtblr }{ m O{} } {
  \cookbook_csv_tblr:nn { #1 }{ #2 }
}


%%%
% Voici les \vars utilisées pour la gestion des données.
%%%
\ior_new:N \g_cookbook_csv_data_ior

\int_new:N   \l_cookbook_csv_num_row_int
\int_new:N   \l_cookbook_csv_num_row_max_int
\int_new:N   \l_cookbook_csv_num_col_int
\int_new:N   \l_cookbook_csv_num_col_max_int
\clist_new:N \l_cookbook_csv_row_clist

\prop_new:N \l_cookbook_csv_table_prop

\tl_new:N \l_cookbook_csv_tblr_tl


%%%
% prototype::
%     :see: cmd.csvread
%%%
\cs_new_protected:Nn \cookbook_csv_read:nn {
% Ouverture d'un flux vers le fichier \csv de données.
  \ior_open:Nn \g_cookbook_csv_data_ior { #2 }

  \prop_clear:N \l_cookbook_csv_table_prop
  \int_zero:N   \l_cookbook_csv_num_row_int

% Lecture ligne par ligne du fichier \csv : chaque contenu de
% ligne sera accessible via ''##1'' (\tech du doublement des
% ''#'' pour les \cmds imbriquées).
  \ior_map_inline:Nn \g_cookbook_csv_data_ior {
    \int_incr:N \l_cookbook_csv_num_row_int

% ''\clist_set:Nn'' de \l3 se charge pour nous d'isoler les
% textes séparés par des virgules, tout en nettoyant les espaces
% initiaux et finaux. Que demander de plus ?
    \clist_clear:N \l_cookbook_csv_row_clist
    \clist_set:Nn  \l_cookbook_csv_row_clist {##1}

    \int_zero:N \l_cookbook_csv_num_col_int

% Lecture \val par \val : chaque contenu de la liste de \vals,
% initialement séparées par des virgules, sera accessible via
% ''####1'' (\tech du doublement des ''#'' pour les \cmds
% imbriquées).
    \clist_map_inline:Nn \l_cookbook_csv_row_clist {
      \int_incr:N \l_cookbook_csv_num_col_int

% Ajout d'une nouvelle \asso clé-valeur.
      \prop_gput:Nen \l_cookbook_csv_table_prop {
        #1
        -
        \int_use:N \l_cookbook_csv_num_row_int
        .
        \int_use:N \l_cookbook_csv_num_col_int
      } { ####1 }
    }
  }

% \Ttes les lignes ont été lues; nous pouvons créer les \vars
% donnant les \nbs totaux de lignes et de \cols.
  \prop_gput:Nne
    \l_cookbook_csv_table_prop
    { #1-nbrows }
    { \int_use:N \l_cookbook_csv_num_row_int }

  \prop_gput:Nne
    \l_cookbook_csv_table_prop
    { #1-nbcols }
    { \int_use:N \l_cookbook_csv_num_col_int }

% Fermeture du flux vers le fichier \csv de données.
  \ior_close:N \g_cookbook_csv_data_ior
}


%%%
% prototype::
%     :see: cmd.csvtblr
%%%
\cs_new_protected:Nn \cookbook_csv_tblr:nn {
  \tl_clear:N \l_cookbook_csv_tblr_tl
  \int_set:Nn \l_cookbook_csv_num_row_int { 1 }

  \int_set:Nn \l_cookbook_csv_num_row_max_int {
    \prop_item:Nn \l_cookbook_csv_table_prop { #1-nbrows }
  }

  \int_set:Nn \l_cookbook_csv_num_col_max_int {
    \prop_item:Nn \l_cookbook_csv_table_prop { #1-nbcols }
  }

  \bool_while_do:nn {
    \int_compare_p:n {
      \l_cookbook_csv_num_row_int < \l_cookbook_csv_num_row_max_int + 1
    }
  }{
    \int_set:Nn \l_cookbook_csv_num_col_int { 1 }

    \bool_while_do:nn {
      \int_compare_p:n {
        \l_cookbook_csv_num_col_int < \l_cookbook_csv_num_col_max_int + 1
      }
    }{
      \tl_put_right:Ne \l_cookbook_csv_tblr_tl {
        \prop_item:Ne \l_cookbook_csv_table_prop {
          #1
          -
          \int_use:N \l_cookbook_csv_num_row_int
          .
          \int_use:N \l_cookbook_csv_num_col_int
        }
      }

      \int_compare:nT {
        \l_cookbook_csv_num_col_int < \l_cookbook_csv_num_col_max_int
      }{
        \tl_put_right:Nn \l_cookbook_csv_tblr_tl { & }
      }

      \int_incr:N \l_cookbook_csv_num_col_int
    }

    \int_compare:nT {
      \l_cookbook_csv_num_row_int < \l_cookbook_csv_num_row_max_int
    }{
      \tl_put_right:Nn \l_cookbook_csv_tblr_tl { \\ }
    }

    \int_incr:N \l_cookbook_csv_num_row_int
  }

% % DEBUGGING - START
%   \tl_show:N \l_cookbook_csv_tblr_tl
% % DEBUGGING - END

%%%
% caution::
%     La \var ''\l_cookbook_csv_tblr_tl'' doit être développée
%     "à la main", car l'\env ''tblr'' ne le fera pas pour nous.
%
%
% note::
%     XXXXXXX
%%%
  \exp_args:NnnV \begin {tblr} {#2} \l_cookbook_csv_tblr_tl
  %
  \end{tblr}
}

\ExplSyntaxOff
