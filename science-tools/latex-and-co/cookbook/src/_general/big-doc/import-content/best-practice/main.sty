\ExplSyntaxOn

%%%
% La liste ordonnée de fichiers à importer est faite de \vals
% séparées par des virgules.
%
% note::
%     ''lof'' est pour "list of files" soit "liste de fichiers"
%     en anglais.
%%%
\clist_new:N \l_cookbook_lof_clist


%%%
% prototype::
%     #1 : la liste de chemins de fichiers (des \vals séparées
%          par des virgules).
%     #2 : un code utilisant un unique \arg ''#1''.
%
%     :action: le code donné en \2e \arg est appliqué à chaque
%              chemin de fichier extrait de la liste.
%%%
\cs_new_protected:Nn \cookbook_easy_import:nn {
%%%
% Initialisation la liste de \vals en laissant le soin à \l3
% de séparer les données suivant les virgules, tout en retirant
% les espaces au début et à la fin de chaque chemin.
%%%
    \clist_set:Nn \l_cookbook_lof_clist {#1}

%%%
% Via un style de \prog fonctionnel, nous appliquons à chaque
% chemin extrait par \l3 le code qui a été fourni en \2nd \arg.
%
%
% note::
%     Dans le code fourni en \2nd \arg, \latex transforme les
%     ''#1'' en ''##1'' (doublement des dièses).
%     Or, ici, ''##1'' correspond justement à un chemin extrait
%     de la liste de \vals donnée via le \1er \arg.
%%%
    \clist_map_inline:Nn \l_cookbook_lof_clist { #2 }
}

%%%
% ''\easyimport'' est un alias de ''\cookbook_easy_import:nn''
% qui sera utilisable comme une macro \std.
%%%
\cs_set_eq:NN \easyimport \cookbook_easy_import:nn

\ExplSyntaxOff
